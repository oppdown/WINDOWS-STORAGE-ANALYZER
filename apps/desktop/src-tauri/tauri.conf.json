{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WINDOWS STORAGE ANALYZER",
  "version": "0.1.5",
  "identifier": "com.oppdown.windowsstorageanalyzer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WINDOWS STORAGE ANALYZER",
        "width": 1280,
        "height": 860,
        "minWidth": 860,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
